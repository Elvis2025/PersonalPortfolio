PORT=4000
CONTACT_TO_EMAIL=you@example.com

# Email delivery (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Portfolio <onboarding@your-verified-domain.com>

# Free visitor auto-reply through Brevo's HTTPS API.
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=you@example.com
# Public URL of the profile photo used inside the email (optional).
PROFILE_IMAGE_URL=https://your-portfolio.com/img/profile/EH-IMG.webp
SOCIAL_TELEGRAM_URL=https://t.me/your_username
SOCIAL_THREADS_URL=https://www.threads.net/@your_username
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/your_username
SOCIAL_X_URL=https://x.com/your_username

# Comma-separated production origins. Local Vite origins are used by default.
ALLOWED_ORIGINS=http://localhost:5173

# Optional absolute directory containing the CV files.
CV_STORAGE_PATH=
