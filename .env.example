PORT=4000
CONTACT_TO_EMAIL=you@example.com

# Email delivery (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Portfolio <onboarding@your-verified-domain.com>

# Gmail SMTP auto-reply. CONTACT_TO_EMAIL is also used as the Gmail username.
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Comma-separated production origins. Local Vite origins are used by default.
ALLOWED_ORIGINS=http://localhost:5173

# Optional absolute directory containing the CV files.
CV_STORAGE_PATH=
