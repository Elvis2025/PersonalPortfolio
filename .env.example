PORT=4000
CONTACT_TO_EMAIL=you@example.com

# Email delivery (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Portfolio <onboarding@your-verified-domain.com>

# Free visitor auto-reply through Brevo's HTTPS API.
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=you@example.com
# Public URL of the profile photo used inside the email (optional).
PROFILE_IMAGE_URL=https://your-portfolio.com/img/profile/elvis-hernandez.webp

# Comma-separated production origins. Local Vite origins are used by default.
ALLOWED_ORIGINS=http://localhost:5173

# Optional absolute directory containing the CV files.
CV_STORAGE_PATH=
